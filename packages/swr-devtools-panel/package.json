{
  "name": "swr-devtools-panel",
  "version": "1.3.2",
  "description": "A React component for the SWR DevTools panel",
  "main": "cjs/index.js",
  "module": "lib/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "types": "lib/index.d.ts",
  "license": "MIT",
  "files": [
    "lib",
    "cjs"
  ],
  "author": "koba04",
  "scripts": {
    "clean": "rimraf lib cjs",
    "start": "run-p start:*",
    "start:cjs": "tsc -p tsconfig.cjs.json --watch",
    "start:esm": "tsc --watch",
    "prebuild": "pnpm clean",
    "build": "run-p build:*",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "format": "biome format --write .",
    "fix:biome": "biome check --write --unsafe .",
    "lint": "run-p lint:*",
    "lint:biome": "biome check .",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=17.0.2",
    "styled-components": "^5.3.0 || ^6.0.0",
    "swr": ">=1.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "styled-components": "^6.6.0",
    "swr": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react-json-tree": "^0.20.0",
    "swr-devtools": "workspace:*"
  }
}
